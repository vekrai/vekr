package templates

import (
	"context"
	"fmt"
	"net/url"

	"vekr/internal/models"
)

type DashboardView struct {
	RecentNotes   []models.Node
	NodeCount     int64
	MasteredCount int64
	Mastered      []models.Topic
	Queue         []models.QueueItem
	Streak        int
	Graph         GraphView
	WeakSpots     []models.WeakSpot
	RecentChats   []models.ChatSummary
}

func queueKindLabel(ctx context.Context, q models.QueueItem) string {
	return t(ctx, "queue.kind."+q.Kind())
}

func queueItemURL(q models.QueueItem) string {
	if q.Kind() == models.QueueKindPractice {
		return fmt.Sprintf("/topics/%d/practice", q.TopicID)
	}
	return fmt.Sprintf("/topics/%d", q.TopicID)
}

func recentChatURL(c models.ChatSummary) string {
	if c.NodeID != nil {
		return fmt.Sprintf("/notes/%d?chat_id=%d", *c.NodeID, c.ChatID)
	}
	return fmt.Sprintf("/?chat_id=%d", c.ChatID)
}

func drillURL(spots ...models.WeakSpot) string {
	q := url.Values{}
	for _, s := range spots {
		q.Add("concept_id", fmt.Sprintf("%d", s.ConceptID))
	}
	return "/drill?" + q.Encode()
}

templ Dashboard(view DashboardView) {
	@layout(dashboardContent(view))
}

templ dashboardContent(view DashboardView) {
	<div class="grid grid-cols-1 md:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] gap-4">
		<div class="flex flex-col gap-4 min-w-0">
			@queueCard(view.Queue)
			@weakSpotsCard(view.WeakSpots)
			@graphCard(view.Graph)
		</div>
		<div class="flex flex-col gap-4 min-w-0">
			@statsCard(view)
			if len(view.RecentChats) > 0 {
				@recentChatsCard(view.RecentChats)
			}
			@recentNotesCard(view.RecentNotes)
			@masteredCard(view.Mastered)
		</div>
	</div>
}

templ queueCard(queue []models.QueueItem) {
	<section class="card">
		<h2 class="section-title mb-3">{ t(ctx, "dashboard.queue.title") }</h2>
		if len(queue) == 0 {
			@emptyText(t(ctx, "dashboard.queue.empty"))
		} else {
			<ul>
				for _, q := range queue {
					<li class="py-2.5 border-b border-gridline last:border-b-0">
						<div class="flex items-center gap-3">
							<a class="flex-1 min-w-0 text-sm font-medium hover:underline" href={ templ.URL(queueItemURL(q)) }>{ q.Title }</a>
							if q.Kind() == models.QueueKindLearn {
								<span class="chip">{ queueKindLabel(ctx, q) }</span>
							} else {
								<span class="shrink-0 text-xs text-ink-secondary tabular-nums">{ fmt.Sprintf("%d / %d", q.Passed, q.ItemCount) }</span>
							}
						</div>
						if q.Kind() == models.QueueKindPractice {
							<div class="mt-2 h-1.5 rounded bg-accent/15 overflow-hidden">
								<div class="h-full rounded bg-accent" style={ fmt.Sprintf("width: %.0f%%", percent(q.Passed, q.ItemCount)) }></div>
							</div>
						}
					</li>
				}
			</ul>
			<a class="btn btn-primary w-full mt-4 py-2.5" href={ templ.URL(queueItemURL(queue[0])) }>{ t(ctx, "dashboard.queue.start") }</a>
		}
	</section>
}

templ weakSpotsCard(spots []models.WeakSpot) {
	<section class="card">
		<h2 class="section-title mb-3">{ t(ctx, "dashboard.weak.title") }</h2>
		if len(spots) == 0 {
			@emptyText(t(ctx, "dashboard.weak.empty"))
		} else {
			<ul>
				for _, spot := range spots {
					<li class="flex items-center gap-3 text-sm py-2.5 border-b border-gridline last:border-b-0">
						<span class="w-1.5 h-1.5 rounded-full bg-serious shrink-0" aria-hidden="true"></span>
						<span class="flex-1 min-w-0 break-words">{ humanize(spot.Name) }</span>
						<span class="shrink-0 text-xs text-ink-muted">{ tCount(ctx, "dashboard.weak.missed", spot.AttemptCount, map[string]any{"Misses": spot.MissCount}) }</span>
						<a class="shrink-0 text-xs text-accent hover:underline" href={ templ.URL(drillURL(spot)) }>{ t(ctx, "dashboard.weak.drill") }</a>
					</li>
				}
			</ul>
			if len(spots) > 1 {
				<a class="btn btn-secondary w-full mt-4" href={ templ.URL(drillURL(spots...)) }>{ t(ctx, "dashboard.weak.together") }</a>
			}
		}
	</section>
}

templ graphCard(graph GraphView) {
	if len(graph.Nodes) > 0 {
		<section class="card">
			<h2 class="section-title mb-3">{ t(ctx, "dashboard.graph.title") }</h2>
			<svg class="w-full h-auto" viewBox={ fmt.Sprintf("0 0 %.0f %.0f", graph.Width, graph.Height) } role="img" aria-label={ t(ctx, "dashboard.graph.title") }>
				for _, e := range graph.Edges {
					<line x1={ fmt.Sprintf("%.1f", e.X1) } y1={ fmt.Sprintf("%.1f", e.Y1) } x2={ fmt.Sprintf("%.1f", e.X2) } y2={ fmt.Sprintf("%.1f", e.Y2) } class={ templ.KV("stroke-accent/60", e.Prerequisite), templ.KV("stroke-ink-muted/40", !e.Prerequisite) } stroke-width="1.5"></line>
				}
				for _, n := range graph.Nodes {
					<a href={ templ.SafeURL(fmt.Sprintf("/notes/%d", n.ID)) } class="group">
						<title>{ n.Title }</title>
						<circle cx={ fmt.Sprintf("%.1f", n.X) } cy={ fmt.Sprintf("%.1f", n.Y) } r="9" class="fill-transparent"></circle>
						<circle cx={ fmt.Sprintf("%.1f", n.X) } cy={ fmt.Sprintf("%.1f", n.Y) } r="5.5" class="fill-surface stroke-accent group-hover:fill-accent" stroke-width="2"></circle>
					</a>
				}
				for _, g := range graph.Groups {
					if g.TopicID != 0 {
						<a href={ templ.SafeURL(fmt.Sprintf("/topics/%d", g.TopicID)) }>
							<text x={ fmt.Sprintf("%.1f", g.X) } y={ fmt.Sprintf("%.1f", g.Y) } text-anchor="middle" class="fill-ink-secondary text-[11px] hover:fill-ink hover:underline">{ graphLabel(g.Label, graph.Width/float64(min(len(graph.Groups), graphMaxCols))) }</text>
						</a>
					} else {
						<text x={ fmt.Sprintf("%.1f", g.X) } y={ fmt.Sprintf("%.1f", g.Y) } text-anchor="middle" class="fill-ink-muted text-[11px]">{ graphLabel(g.Label, graph.Width/float64(min(len(graph.Groups), graphMaxCols))) }</text>
					}
				}
			</svg>
		</section>
	}
}

templ masteredCard(mastered []models.Topic) {
	<section class="card">
		<h2 class="section-title mb-3">{ t(ctx, "dashboard.mastered.title") }</h2>
		if len(mastered) == 0 {
			@emptyText(t(ctx, "dashboard.mastered.empty"))
		} else {
			<ul>
				for _, topic := range mastered {
					<li class="flex items-center gap-2.5 text-sm py-2.5 border-b border-gridline last:border-b-0">
						<span class="w-[18px] h-[18px] rounded-full bg-good/15 text-good flex items-center justify-center text-[11px] font-bold shrink-0" aria-hidden="true">✓</span>
						<a class="flex-1 min-w-0 hover:underline" href={ templ.URL(fmt.Sprintf("/topics/%d", topic.ID)) }>{ topic.Title }</a>
						<span class="shrink-0 text-xs text-ink-muted">{ relativeDate(ctx, topic.UpdatedAt) }</span>
					</li>
				}
			</ul>
		}
	</section>
}

templ statsCard(view DashboardView) {
	<section class="card">
		<h2 class="section-title mb-3">{ t(ctx, "dashboard.stats.title") }</h2>
		<dl class="grid grid-cols-3 gap-3">
			<div>
				<dt class="text-xs text-ink-muted mb-1">{ t(ctx, "dashboard.stats.streak") }</dt>
				<dd class="text-[26px] font-semibold leading-tight">{ tCount(ctx, "dashboard.stats.days", view.Streak, nil) }</dd>
			</div>
			<div>
				<dt class="text-xs text-ink-muted mb-1">{ t(ctx, "dashboard.stats.notes") }</dt>
				<dd class="text-[26px] font-semibold leading-tight">{ fmt.Sprintf("%d", view.NodeCount) }</dd>
			</div>
			<div>
				<dt class="text-xs text-ink-muted mb-1">{ t(ctx, "dashboard.stats.mastered") }</dt>
				<dd class="text-[26px] font-semibold leading-tight">{ fmt.Sprintf("%d", view.MasteredCount) }</dd>
			</div>
		</dl>
	</section>
}

templ recentChatsCard(chats []models.ChatSummary) {
	<section class="card">
		<h2 class="section-title mb-3">{ t(ctx, "chat.recent") }</h2>
		for _, c := range chats {
			<a class="flex items-baseline gap-3 text-sm py-2 border-b border-gridline last:border-b-0 group" href={ templ.URL(recentChatURL(c)) }>
				<span class="flex-1 min-w-0">
					<span class="block truncate text-ink-secondary group-hover:text-ink group-hover:underline">
						if c.Title != "" {
							{ c.Title }
						} else {
							{ t(ctx, "chat.untitled") }
						}
					</span>
					if c.NodeTitle != nil {
						<span class="block truncate text-[11px] text-ink-muted mt-0.5">{ tData(ctx, "chat.on_note", map[string]any{"Title": *c.NodeTitle}) }</span>
					}
				</span>
				<span class="shrink-0 text-[11px] text-ink-muted">{ relativeDate(ctx, c.LastAt) }</span>
			</a>
		}
	</section>
}

templ recentNotesCard(notes []models.Node) {
	<section class="card">
		<div class="flex items-baseline justify-between gap-3 mb-3">
			<h2 class="section-title">{ t(ctx, "dashboard.recent.title") }</h2>
			<a class="text-xs text-accent hover:underline" href="/notes">{ t(ctx, "dashboard.recent.all") }</a>
		</div>
		if len(notes) == 0 {
			@emptyText(t(ctx, "notes.empty"))
		} else {
			for _, node := range notes {
				<a class="flex items-baseline gap-3 text-sm py-2 border-b border-gridline last:border-b-0 group" href={ templ.URL(fmt.Sprintf("/notes/%d", node.ID)) }>
					<span class="flex-1 min-w-0 text-ink-secondary group-hover:text-ink group-hover:underline">{ node.Title }</span>
					<span class="shrink-0 text-[11px] text-ink-muted">{ relativeDate(ctx, node.CreatedAt) }</span>
				</a>
			}
		}
	</section>
}
