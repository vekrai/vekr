package templates

import (
	"context"
	"fmt"
	"net/url"

	"vekr/internal/models"
)

type DashboardView struct {
	RecentNotes   []models.Node
	NodeCount     int64
	MasteredCount int64
	Mastered      []models.Node
	PathProgress  []models.PathProgress
	Queue         []models.QueueItem
	WeakSpots     []models.WeakSpot
	Chat          models.Chat
	Messages      []models.ChatMessage
	MessageHTML   []string
	ChatBusy      bool
}

func progressPercent(p models.PathProgress) float64 {
	if p.Total == 0 {
		return 0
	}
	return float64(p.Mastered) / float64(p.Total) * 100
}

func queueKindLabel(ctx context.Context, q models.QueueItem) string {
	return t(ctx, "queue.kind."+q.Kind())
}

func queueItemURL(q models.QueueItem) string {
	if q.Kind() == models.QueueKindPractice {
		return fmt.Sprintf("/topics/%d/practice", q.NodeID)
	}
	return fmt.Sprintf("/notes/%d", q.NodeID)
}

func drillURL(spots ...models.WeakSpot) string {
	q := url.Values{}
	for _, s := range spots {
		q.Add("concept_id", fmt.Sprintf("%d", s.ConceptID))
	}
	return "/drill?" + q.Encode()
}

templ Dashboard(view DashboardView) {
	@layout(dashboardContent(view))
}

templ dashboardContent(view DashboardView) {
	<div class="grid md:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] gap-4">

		<div class="flex flex-col gap-4 min-w-0">

			<div class="bg-surface border border-black/10 rounded-xl p-5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">{ t(ctx, "dashboard.queue.title") }</h2>
				if len(view.Queue) == 0 {
					<p class="text-xs text-ink-muted">{ t(ctx, "dashboard.queue.empty") }</p>
					<button class="mt-3.5 w-full bg-ink/30 text-surface rounded-lg py-2.5 text-sm font-semibold cursor-not-allowed" disabled>{ t(ctx, "dashboard.queue.start") }</button>
				} else {
					for _, q := range view.Queue {
						<div class="flex items-center gap-3 py-2.5 border-b border-gridline last:border-b-0">
							if q.Kind() == models.QueueKindPractice {
								<div class="w-[9px] h-[9px] rounded-full border-2 border-accent bg-accent shrink-0"></div>
							} else {
								<div class="w-[9px] h-[9px] rounded-full border-2 border-accent shrink-0"></div>
							}
							<a class="flex-1 min-w-0 text-sm hover:underline" href={ templ.URL(queueItemURL(q)) }>{ q.Title }</a>
							<span class="shrink-0 text-[11px] px-2 py-0.5 rounded-full border border-gridline bg-page text-ink-secondary">{ queueKindLabel(ctx, q) }</span>
						</div>
					}
					<a class="mt-3.5 block w-full text-center bg-ink text-surface rounded-lg py-2.5 text-sm font-semibold hover:opacity-85" href={ templ.URL(queueItemURL(view.Queue[0])) }>{ t(ctx, "dashboard.queue.start") }</a>
				}
			</div>

			<div class="bg-surface border border-black/10 rounded-xl p-5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">{ t(ctx, "dashboard.paths.title") }</h2>
				if len(view.PathProgress) == 0 {
					<p class="text-xs text-ink-muted">{ t(ctx, "dashboard.paths.empty") }</p>
				} else {
					<div class="flex flex-col gap-3.5">
						for _, p := range view.PathProgress {
							<div>
								<div class="flex justify-between gap-3 text-[13px] mb-1.5">
									<span>{ p.Path.Title }</span>
									<span class="shrink-0 text-ink-secondary tabular-nums">{ fmt.Sprintf("%d / %d", p.Mastered, p.Total) }</span>
								</div>
								<div class="h-2 rounded bg-accent/20 overflow-hidden">
									<div class="h-full rounded bg-accent" style={ fmt.Sprintf("width: %.0f%%", progressPercent(p)) }></div>
								</div>
							</div>
						}
					</div>
				}
			</div>

			<div class="bg-surface border border-black/10 rounded-xl p-5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">{ t(ctx, "dashboard.mastered.title") }</h2>
				if len(view.Mastered) == 0 {
					<p class="text-xs text-ink-muted">{ t(ctx, "dashboard.mastered.empty") }</p>
				} else {
					for _, node := range view.Mastered {
						<div class="flex items-center gap-2.5 text-[13px] py-2.5 border-b border-gridline last:border-b-0">
							<div class="w-[18px] h-[18px] rounded-full bg-good/20 text-good flex items-center justify-center text-[11px] font-bold shrink-0">✓</div>
							<a class="flex-1 min-w-0 hover:underline" href={ templ.URL(fmt.Sprintf("/notes/%d", node.ID)) }>{ node.Title }</a>
							<span class="shrink-0">{ node.UpdatedAt.Format("Jan 2, 2006") }</span>
						</div>
					}
				}
			</div>

		</div>

		<div class="flex flex-col gap-4 min-w-0">

			@chatPanel(view.Chat, 0, view.Messages, view.MessageHTML, view.ChatBusy)

			<div class="bg-surface border border-black/10 rounded-xl p-5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">{ t(ctx, "dashboard.recent.title") }</h2>
				if len(view.RecentNotes) == 0 {
					<p class="text-xs text-ink-muted">{ t(ctx, "notes.empty") }</p>
				} else {
					for _, node := range view.RecentNotes {
						<div class="text-[13px] py-2 border-b border-gridline last:border-b-0">
							<a class="text-ink-secondary hover:underline" href={ templ.URL(fmt.Sprintf("/notes/%d", node.ID)) }>{ node.Title }</a>
							<span class="block text-[11px] text-ink-muted mt-0.5">{ node.CreatedAt.Format("Jan 2, 2006") }</span>
						</div>
					}
				}
			</div>

			<div class="bg-surface border border-black/10 rounded-xl p-5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">{ t(ctx, "dashboard.weak.title") }</h2>
				if len(view.WeakSpots) == 0 {
					<p class="text-xs text-ink-muted">{ t(ctx, "dashboard.weak.empty") }</p>
				} else {
					for _, spot := range view.WeakSpots {
						<div class="flex items-center gap-2.5 text-[13px] py-2.5 border-b border-gridline last:border-b-0">
							<div class="w-[18px] h-[18px] rounded-full bg-serious/20 text-serious flex items-center justify-center text-xs font-bold shrink-0">!</div>
							<span class="flex-1 min-w-0">{ spot.Name }</span>
							<span class="shrink-0 text-xs text-ink-muted">{ tCount(ctx, "dashboard.weak.missed", spot.AttemptCount, map[string]any{"Misses": spot.MissCount}) }</span>
							<a class="shrink-0 text-xs text-accent hover:underline" href={ templ.URL(drillURL(spot)) }>{ t(ctx, "dashboard.weak.drill") }</a>
						</div>
					}
					if len(view.WeakSpots) > 1 {
						<a class="mt-3.5 block w-full text-center bg-ink text-surface rounded-lg py-2.5 text-sm font-semibold hover:opacity-85" href={ templ.URL(drillURL(view.WeakSpots...)) }>{ t(ctx, "dashboard.weak.together") }</a>
					}
				}
			</div>

			<div class="bg-surface border border-black/10 rounded-xl p-5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">{ t(ctx, "dashboard.stats.title") }</h2>
				<div class="grid grid-cols-3 gap-3">
					<div>
						<div class="text-xs text-ink-muted mb-1">{ t(ctx, "dashboard.stats.streak") }</div>
						<div class="text-[26px] font-semibold leading-tight">—</div>
					</div>
					<div>
						<div class="text-xs text-ink-muted mb-1">{ t(ctx, "dashboard.stats.nodes") }</div>
						<div class="text-[26px] font-semibold leading-tight">{ fmt.Sprintf("%d", view.NodeCount) }</div>
					</div>
					<div>
						<div class="text-xs text-ink-muted mb-1">{ t(ctx, "dashboard.stats.mastered") }</div>
						<div class="text-[26px] font-semibold leading-tight">{ fmt.Sprintf("%d", view.MasteredCount) }</div>
					</div>
				</div>
			</div>

		</div>
	</div>
}
