package templates

import (
	"fmt"

	"vekr/internal/models"
)

templ Dashboard(recentNotes []models.Node, nodeCount int64, chat models.Chat, messages []models.ChatMessage) {
	@layout(dashboardContent(recentNotes, nodeCount, chat, messages))
}

templ dashboardContent(recentNotes []models.Node, nodeCount int64, chat models.Chat, messages []models.ChatMessage) {
	<div class="grid md:grid-cols-[1.6fr_1fr] gap-4">

		<div class="flex flex-col gap-4">

			<div class="bg-surface border border-black/10 rounded-xl p-5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">Today's queue</h2>
				<p class="text-xs text-ink-muted">No items due yet — the scheduler isn't wired up.</p>
				<button class="mt-3.5 w-full bg-ink/30 text-surface rounded-lg py-2.5 text-sm font-semibold cursor-not-allowed" disabled>Start today's session</button>
			</div>

			<div class="bg-surface border border-black/10 rounded-xl p-5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">Active learning paths</h2>
				<p class="text-xs text-ink-muted">No learning paths yet.</p>
			</div>

			<div class="bg-surface border border-black/10 rounded-xl p-5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">Mastered</h2>
				<p class="text-xs text-ink-muted">Nothing mastered yet.</p>
			</div>

		</div>

		<div class="flex flex-col gap-4">

			<div class="bg-surface border border-black/10 rounded-xl p-5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">Chat with V</h2>
				if len(messages) > 0 {
					<div class="flex flex-col gap-2 mb-2.5 max-h-64 overflow-y-auto">
						for _, m := range messages {
							if m.Role == "user" {
								<div class="text-sm self-end max-w-[85%] bg-ink text-surface rounded-lg px-3 py-1.5">{ m.Content }</div>
							} else {
								<div class="text-sm self-start max-w-[85%] bg-page border border-black/10 rounded-lg px-3 py-1.5">{ m.Content }</div>
							}
						}
					</div>
				}
				<form method="POST" action="/chat/messages">
					<input type="hidden" name="chat_id" value={ fmt.Sprintf("%d", chat.ID) }/>
					<div class="border border-black/10 rounded-lg bg-page p-2.5">
						<textarea class="block w-full bg-transparent text-sm resize-none outline-none placeholder:text-ink-muted" name="content" placeholder="Talk, paste material, or drop a file…" rows="2"></textarea>
						<div class="flex justify-between items-center mt-1.5">
							<span class="text-ink-muted text-sm">📎</span>
							<button class="bg-ink text-surface rounded-md py-1.5 px-3.5 text-sm font-semibold" type="submit">Send</button>
						</div>
					</div>
				</form>
			</div>

			<div class="bg-surface border border-black/10 rounded-xl p-5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">Recent notes</h2>
				if len(recentNotes) == 0 {
					<p class="text-xs text-ink-muted">No notes yet.</p>
				} else {
					for _, node := range recentNotes {
						<div class="text-sm py-2 border-b border-gridline last:border-b-0">
							<a class="text-ink-secondary hover:underline" href={ templ.URL(fmt.Sprintf("/notes/%d", node.ID)) }>{ node.Title }</a>
							<span class="block text-[11px] text-ink-muted mt-0.5">{ node.CreatedAt.Format("Jan 2, 2006") }</span>
						</div>
					}
				}
			</div>

			<div class="bg-surface border border-black/10 rounded-xl p-5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">Weak spots</h2>
				<p class="text-xs text-ink-muted">No weak spots tracked yet.</p>
			</div>

			<div class="bg-surface border border-black/10 rounded-xl p-5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">Stats</h2>
				<div class="grid grid-cols-3 gap-3">
					<div>
						<div class="text-xs text-ink-muted mb-1">Streak</div>
						<div class="text-2xl font-semibold leading-tight">—</div>
					</div>
					<div>
						<div class="text-xs text-ink-muted mb-1">Nodes</div>
						<div class="text-2xl font-semibold leading-tight">{ fmt.Sprintf("%d", nodeCount) }</div>
					</div>
					<div>
						<div class="text-xs text-ink-muted mb-1">Mastered</div>
						<div class="text-2xl font-semibold leading-tight">—</div>
					</div>
				</div>
			</div>

		</div>
	</div>
}
