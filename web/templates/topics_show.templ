package templates

import (
	"fmt"

	"vekr/internal/models"
)

templ TopicsShow(progress models.TopicProgress, contentHTML string, notes []models.Node) {
	@layout(topicsShowContent(progress, contentHTML, notes))
}

templ topicsShowContent(progress models.TopicProgress, contentHTML string, notes []models.Node) {
	<div class="bg-surface border border-black/10 rounded-xl p-5 mb-4">
		<div class="flex justify-between items-center gap-3 mb-3.5">
			<h2 class="flex-1 text-[13px] font-semibold uppercase tracking-wide text-ink-secondary">{ progress.Topic.Title }</h2>
			<span class="shrink-0 text-[11px] px-2 py-0.5 rounded-full border border-gridline bg-page text-ink-secondary">{ t(ctx, "topic.status."+progress.Topic.Status) }</span>
			<a class="shrink-0 text-xs text-ink-secondary hover:underline" href={ templ.URL(fmt.Sprintf("/topics/%d/practice", progress.Topic.ID)) }>{ t(ctx, "topic.practice") }</a>
		</div>
		if progress.Topic.Content != "" {
			<div class="markdown text-sm mb-3.5">
				@templ.Raw(contentHTML)
			</div>
		}
		<div class="flex justify-between gap-3 text-xs text-ink-secondary mb-1.5">
			<span>{ tData(ctx, "topic.progress", map[string]any{"Passed": progress.Passed, "Total": progress.Total}) }</span>
		</div>
		<div class="h-2 rounded bg-accent/20 overflow-hidden">
			<div class="h-full rounded bg-accent" style={ fmt.Sprintf("width: %.0f%%", progressPercent(progress)) }></div>
		</div>
	</div>

	<div class="bg-surface border border-black/10 rounded-xl p-5 mb-4">
		<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary mb-3.5">{ t(ctx, "topic.notes") }</h2>
		if len(notes) == 0 {
			<p class="text-xs text-ink-muted">{ t(ctx, "topic.notes_empty") }</p>
		} else {
			for _, node := range notes {
				<div class="text-sm py-2 border-b border-gridline last:border-b-0">
					<a class="text-ink hover:underline" href={ templ.URL(fmt.Sprintf("/notes/%d", node.ID)) }>{ node.Title }</a>
				</div>
			}
		}
		<a class="inline-block mt-3 text-xs text-accent hover:underline" href="/">{ t(ctx, "topic.back") }</a>
	</div>
}
