package templates

import (
	"fmt"

	"vekr/internal/models"
)

templ NotesIndex(view NotesIndexView) {
	@layout(notesIndexContent(view))
}

templ notesIndexContent(view NotesIndexView) {
	@pageHeader([]crumb{dashboardCrumb(ctx)}, t(ctx, "notes.title"))
	<div class="grid grid-cols-1 md:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] gap-4">
		<section class="card min-w-0 self-start">
			<form method="GET" action="/notes" class="flex gap-2 mb-4" role="search">
				<input class="field" type="search" name="q" value={ view.Query } placeholder={ t(ctx, "notes.search_placeholder") } aria-label={ t(ctx, "notes.search_placeholder") }/>
				<button class="btn btn-secondary" type="submit">{ t(ctx, "notes.search") }</button>
			</form>
			if view.Query != "" {
				<div class="flex items-baseline justify-between gap-3 mb-2">
					<p class="text-xs text-ink-muted">{ tCount(ctx, "notes.results", len(view.Hits), map[string]any{"Query": view.Query}) }</p>
					<a class="text-xs text-accent hover:underline" href="/notes">{ t(ctx, "notes.clear") }</a>
				</div>
				for _, hit := range view.Hits {
					<a class="block py-2.5 border-b border-gridline last:border-b-0 group" href={ templ.URL(fmt.Sprintf("/notes/%d", hit.NodeID)) }>
						<span class="block text-sm group-hover:underline">{ hit.Title }</span>
						@topicLabel(view.TopicTitles, hit.TopicID)
						<span class="block text-xs text-ink-secondary mt-1 line-clamp-2">{ plainSnippet(hit.Snippet) }</span>
					</a>
				}
			} else {
				<p class="text-xs text-ink-muted mb-2">{ tCount(ctx, "notes.count", len(view.Nodes), nil) }</p>
				if len(view.Nodes) == 0 {
					@emptyText(t(ctx, "notes.empty"))
				}
				for _, node := range view.Nodes {
					<a class="flex items-baseline gap-3 py-2.5 border-b border-gridline last:border-b-0 group" href={ templ.URL(fmt.Sprintf("/notes/%d", node.ID)) }>
						<span class="flex-1 min-w-0">
							<span class="block text-sm group-hover:underline">{ node.Title }</span>
							@topicLabel(view.TopicTitles, node.TopicID)
						</span>
						<span class="shrink-0 text-[11px] text-ink-muted">{ relativeDate(ctx, node.CreatedAt) }</span>
					</a>
				}
			}
		</section>

		<section class="card min-w-0 self-start">
			<h2 class="section-title mb-3">{ t(ctx, "notes.new") }</h2>
			@noteForm("/notes", models.Node{}, t(ctx, "notes.create"))
		</section>
	</div>
}

templ topicLabel(titles map[uint]string, topicID *uint) {
	if topicID != nil {
		if title, ok := titles[*topicID]; ok {
			<span class="block text-[11px] text-ink-muted mt-0.5">{ title }</span>
		}
	}
}

templ noteForm(action string, node models.Node, submit string) {
	<form method="POST" action={ templ.URL(action) } class="flex flex-col gap-2">
		<input class="field" name="title" value={ node.Title } placeholder={ t(ctx, "notes.field.title") } aria-label={ t(ctx, "notes.field.title") } required/>
		<textarea class="field resize-y" name="content" rows="8" placeholder={ t(ctx, "notes.field.content") } aria-label={ t(ctx, "notes.field.content") }>{ node.Content }</textarea>
		<div>
			<button class="btn btn-primary" type="submit">{ submit }</button>
		</div>
	</form>
}

templ NotesEdit(node models.Node, topic *models.Topic) {
	@layout(notesEditContent(node, topic))
}

templ notesEditContent(node models.Node, topic *models.Topic) {
	@pageHeader(append(noteCrumbs(ctx, NoteView{Topic: topic}), crumb{Label: node.Title, URL: fmt.Sprintf("/notes/%d", node.ID)}), t(ctx, "note.edit_title"))
	<section class="card max-w-3xl">
		@noteForm(fmt.Sprintf("/notes/%d", node.ID), node, t(ctx, "note.save"))
	</section>
}
