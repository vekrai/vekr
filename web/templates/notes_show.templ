package templates

import (
	"fmt"

	"vekr/internal/models"
)

templ NotesShow(node models.Node, contentHTML string, chat models.Chat, messages []models.ChatMessage, messageHTML []string, chatBusy bool) {
	@layout(notesShowContent(node, contentHTML, chat, messages, messageHTML, chatBusy))
}

templ notesShowContent(node models.Node, contentHTML string, chat models.Chat, messages []models.ChatMessage, messageHTML []string, chatBusy bool) {
	<div class="grid md:grid-cols-[1.6fr_1fr] gap-4">
		<div class="bg-surface border border-black/10 rounded-xl p-5">
			<div class="flex justify-between items-center mb-3.5">
				<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary">{ node.Title }</h2>
				if node.Type == models.NodeTypeTopic {
					<a class="text-xs text-ink-secondary hover:underline" href={ templ.URL(fmt.Sprintf("/topics/%d/practice", node.ID)) }>Practice</a>
				} else {
					<form method="POST" action={ templ.URL(fmt.Sprintf("/notes/%d/promote", node.ID)) }>
						<button class="text-xs text-ink-secondary hover:underline" type="submit">Turn into topic</button>
					</form>
				}
			</div>
			<div class="text-sm">
				@templ.Raw(contentHTML)
			</div>
			<p class="text-xs text-ink-muted mt-2">{ node.CreatedAt.Format("Jan 2, 2006 15:04") }</p>
			<a class="inline-block mt-2 text-xs text-accent hover:underline" href="/notes">Back to notes</a>
		</div>
		<div>
			@chatPanel(chat, node.ID, messages, messageHTML, chatBusy)
		</div>
	</div>
}
