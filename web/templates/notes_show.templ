package templates

import (
	"fmt"

	"vekr/internal/models"
)

templ NotesShow(node models.Node, topic *models.Topic, contentHTML string) {
	@layoutFor(node.ID, notesShowContent(node, topic, contentHTML))
}

templ notesShowContent(node models.Node, topic *models.Topic, contentHTML string) {
	<div class="bg-surface border border-black/10 rounded-xl p-5">
		<div class="flex justify-between items-start gap-4 mb-3.5">
			<h2 class="text-[13px] font-semibold uppercase tracking-wide text-ink-secondary">{ node.Title }</h2>
			if topic != nil {
				<a class="shrink-0 text-xs text-ink-secondary hover:underline" href={ templ.URL(fmt.Sprintf("/topics/%d", topic.ID)) }>{ tData(ctx, "note.topic", map[string]any{"Title": topic.Title}) }</a>
			} else {
				<form class="shrink-0" method="POST" action={ templ.URL(fmt.Sprintf("/notes/%d/promote", node.ID)) }>
					<button class="text-xs text-ink-secondary hover:underline" type="submit">{ t(ctx, "note.promote") }</button>
				</form>
			}
		</div>
		<div class="markdown text-sm">
			@templ.Raw(contentHTML)
		</div>
		<p class="text-xs text-ink-muted mt-4">{ node.CreatedAt.Format("Jan 2, 2006 15:04") }</p>
		<a class="inline-block mt-2 text-xs text-accent hover:underline" href="/notes">{ t(ctx, "note.back") }</a>
	</div>
}
