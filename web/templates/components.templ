package templates

templ pageHeader(crumbs []crumb, title string) {
	<header class="mb-5">
		if len(crumbs) > 0 {
			<nav class="flex flex-wrap items-center gap-1.5 text-xs text-ink-muted mb-2" aria-label={ t(ctx, "nav.breadcrumb") }>
				for i, c := range crumbs {
					if i > 0 {
						<span aria-hidden="true">/</span>
					}
					<a class="hover:text-ink hover:underline" href={ templ.URL(c.URL) }>{ c.Label }</a>
				}
			</nav>
		}
		<div class="flex flex-wrap items-start gap-x-4 gap-y-3">
			<h1 class="flex-1 min-w-0 text-2xl font-semibold leading-tight tracking-tight">{ title }</h1>
			<div class="flex items-center gap-2 shrink-0">
				{ children... }
			</div>
		</div>
	</header>
}

templ themeToggle() {
	<button type="button" class="h-9 w-9 shrink-0 rounded-lg border border-line bg-surface text-ink-secondary hover:border-line-strong hover:text-ink flex items-center justify-center" data-controller="theme" data-action="theme#toggle" title={ t(ctx, "theme.toggle") } aria-label={ t(ctx, "theme.toggle") }>
		<svg class="w-4 h-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
		<svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
	</button>
}

templ emptyText(text string) {
	<p class="text-sm text-ink-muted">{ text }</p>
}
