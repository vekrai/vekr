package templates

templ layout(content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Vekr</title>
		<link rel="stylesheet" href="/static/css/app.css"/>
	</head>
	<body>
		<div class="page">
			<div class="topbar">
				<div class="logo">V</div>
				<div class="topbar-spacer"></div>
			</div>
			@content
		</div>
	</body>
	</html>
}
