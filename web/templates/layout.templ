package templates

import (
	"fmt"

	"vekr/internal/assets"
	"vekr/internal/i18n"
)

func importMap() string {
	return `<script type="importmap" data-turbo-track="reload">` + assets.ImportMap(map[string]string{
		"@hotwired/turbo":    "js/turbo.min.js",
		"@hotwired/stimulus": "js/stimulus.min.js",
	}, "js/controllers") + `</script>`
}

templ layout(content templ.Component) {
	@layoutFor(0, content)
}

templ layoutFor(nodeID uint, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ i18n.Lang(ctx) }>
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ t(ctx, "app.title") }</title>
		<meta name="turbo-refresh-method" content="morph"/>
		<meta name="turbo-refresh-scroll" content="preserve"/>
		<link rel="icon" type="image/svg+xml" href={ assets.Path("images/logo.svg") }/>
		<link rel="stylesheet" href={ assets.Path("css/app.css") } data-turbo-track="reload"/>
		@templ.Raw(importMap())
		<script type="module" src={ assets.Path("js/application.js") } data-turbo-track="reload"></script>
	</head>
	<body class="m-0 bg-page text-ink font-sans">
		{{ chat := chatState(ctx) }}
		<div class="max-w-[1180px] mx-auto px-6 pt-5 pb-14" data-controller="chat-modal" data-chat-modal-chat-id-value={ fmt.Sprintf("%d", chat.Chat.ID) } data-action="turbo:morph@document->chat-modal#sync">
			<div class="flex items-center gap-4 mb-5">
				<a href="/" class="w-9 h-9 shrink-0"><img src={ assets.Path("images/logo.svg") } alt={ t(ctx, "app.title") } class="w-9 h-9"/></a>
				<div class="ml-auto w-full max-w-sm">
					@chatLauncher(nodeID)
				</div>
				@localeToggle(chat.PagePath)
			</div>
			@content
			@chatModal(chat, nodeID)
		</div>
	</body>
	</html>
}

templ localeToggle(returnTo string) {
	{{ zh := i18n.Lang(ctx) == "zh" }}
	<form method="post" action="/locale" class="shrink-0">
		<input type="hidden" name="return_to" value={ returnTo }/>
		<button type="submit" class="h-9 px-3 rounded-lg border border-black/10 bg-surface text-sm text-ink-muted hover:border-black/20 flex items-center gap-1" title={ t(ctx, "locale.toggle") } aria-label={ t(ctx, "locale.toggle") }>
			<span class={ templ.KV("font-bold text-ink", !zh) }>A</span>
			<span>/</span>
			<span class={ templ.KV("font-bold text-ink", zh) }>文</span>
		</button>
	</form>
}
