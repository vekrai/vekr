package templates

import "vekr/internal/i18n"

templ layout(content templ.Component) {
	<!DOCTYPE html>
	<html lang={ i18n.Lang(ctx) }>
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ t(ctx, "app.title") }</title>
		<meta name="turbo-refresh-method" content="morph"/>
		<meta name="turbo-refresh-scroll" content="preserve"/>
		<link rel="stylesheet" href="/static/css/app.css"/>
		<script type="importmap">
			{
				"imports": {
					"@hotwired/turbo": "/static/js/turbo.min.js",
					"@hotwired/stimulus": "/static/js/stimulus.min.js",
					"controllers/": "/static/js/controllers/"
				}
			}
		</script>
		<script type="module" src="/static/js/application.js"></script>
	</head>
	<body class="m-0 bg-page text-ink font-sans">
		<div class="max-w-[1180px] mx-auto px-6 pt-5 pb-14">
			<div class="flex items-center gap-4 mb-5">
				<a href="/" class="w-9 h-9 rounded-[10px] bg-ink text-surface flex items-center justify-center font-bold text-[17px] shrink-0">V</a>
			</div>
			@content
		</div>
	</body>
	</html>
}
