package templates

import (
	"context"
	"fmt"

	"vekr/internal/models"
)

func chatStreamURL(chat models.Chat, messages []models.ChatMessage) string {
	var latest uint
	for _, m := range messages {
		if m.ID > latest {
			latest = m.ID
		}
	}
	return fmt.Sprintf("/streams/chat/%d?after=%d", chat.ID, latest)
}

func chatPlaceholder(ctx context.Context, chat models.Chat, nodeID uint) string {
	if chat.NodeID != nil || (chat.ID == 0 && nodeID != 0) {
		return t(ctx, "chat.placeholder_note")
	}
	return t(ctx, "chat.placeholder")
}

templ chatSaveButton(chat models.Chat) {
	<form method="POST" action={ templ.URL(fmt.Sprintf("/chat/%d/distill", chat.ID)) }>
		<button class="text-xs text-ink-secondary hover:underline" type="submit">{ t(ctx, "chat.save_as_note") }</button>
	</form>
}

templ chatMessages(messages []models.ChatMessage, messageHTML []string, busy bool) {
	for i, m := range messages {
		if m.Role == "user" {
			<div class="markdown text-sm self-end max-w-[85%] min-w-0 bg-ink text-surface rounded-lg px-3 py-1.5">
				@templ.Raw(messageHTML[i])
			</div>
		} else {
			<div class="markdown text-sm self-start max-w-[85%] min-w-0 bg-page border border-black/10 rounded-lg px-3 py-1.5">
				@templ.Raw(messageHTML[i])
			</div>
		}
	}
	if busy {
		<div class="text-sm self-start max-w-[85%] bg-page border border-black/10 rounded-lg px-3 py-1.5 text-ink-muted">{ t(ctx, "chat.thinking") }<span class="thinking-dots" aria-hidden="true"></span></div>
	}
}

templ chatForm(state ChatState, nodeID uint) {
	<form method="POST" action="/chat/messages">
		<input type="hidden" name="return_to" value={ state.PagePath }/>
		if state.Chat.ID != 0 {
			<input type="hidden" name="chat_id" value={ fmt.Sprintf("%d", state.Chat.ID) }/>
		} else {
			<input type="hidden" name="node_id" value={ fmt.Sprintf("%d", nodeID) }/>
		}
		<div class="border border-black/10 rounded-lg bg-page p-2.5">
			<textarea data-chat-modal-target="input" data-controller="chat-input" data-action="keydown->chat-input#keydown" class="block w-full bg-transparent text-sm resize-none outline-none placeholder:text-ink-muted" name="content" placeholder={ chatPlaceholder(ctx, state.Chat, nodeID) } rows="2" disabled?={ state.Busy }></textarea>
			<div class="flex justify-end items-center mt-1.5">
				<button class="bg-ink text-surface rounded-md py-1.5 px-3.5 text-sm font-semibold disabled:opacity-30 disabled:cursor-not-allowed" type="submit" disabled?={ state.Busy }>{ t(ctx, "chat.send") }</button>
			</div>
		</div>
	</form>
}

templ chatLauncher(nodeID uint) {
	<input class="block w-full h-9 border border-black/10 rounded-lg bg-surface px-3 text-sm outline-none placeholder:text-ink-muted cursor-text hover:border-black/20" type="text" placeholder={ chatPlaceholder(ctx, models.Chat{}, nodeID) } readonly data-action="click->chat-modal#openNew focus->chat-modal#openNew"/>
}

templ chatModal(state ChatState, nodeID uint) {
	<div data-chat-modal-target="modal" data-action="click->chat-modal#backdrop" class="fixed inset-0 z-50 bg-ink/30 flex items-center justify-center p-6" hidden?={ !state.Open }>
		<div class="bg-surface border border-black/10 rounded-xl shadow-xl w-full max-w-3xl h-[85vh] flex flex-col p-5">
			if state.Chat.ID != 0 {
				<turbo-stream-source src={ chatStreamURL(state.Chat, state.Messages) }></turbo-stream-source>
			}
			<div class="flex items-center gap-4 mb-3.5">
				<h2 class="flex-1 text-[13px] font-semibold uppercase tracking-wide text-ink-secondary">{ t(ctx, "chat.title") }</h2>
				if len(state.Messages) > 0 && !state.Busy {
					@chatSaveButton(state.Chat)
				}
				<button class="w-7 h-7 rounded-md text-ink-secondary hover:bg-page flex items-center justify-center text-lg leading-none" type="button" title={ t(ctx, "chat.minimize") } aria-label={ t(ctx, "chat.minimize") } data-action="chat-modal#minimize">–</button>
			</div>
			<div data-chat-modal-target="messages" class="flex-1 min-h-0 flex flex-col gap-2 mb-2.5 overflow-y-auto">
				@chatMessages(state.Messages, state.MessageHTML, state.Busy)
			</div>
			@chatForm(state, nodeID)
		</div>
	</div>
}
